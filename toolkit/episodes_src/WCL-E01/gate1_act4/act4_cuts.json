 ],
 [
  "E01-A4-41",
  104.23,
  107.63,
  "It doesn't. The blue bends again,"
 ],
 [
  "E01-A4-42",
  107.63,
  109.73,
  "by its own fixed amount."
 ],
 [
  "E01-A4-43",
  109.73,
  112.19,
  "He tries the other colours too."
 ],
 [
  "E01-A4-44",
  112.19,
  114.79,
  "Once a colour is separated, he says,"
 ],
 [
  "E01-A4-45",
  114.79,
  117.16,
  "it obstinately retained its colour,"
 ],
 [
  "E01-A4-46",
  117.16,
  119.2,
  "whatever he did to it."
 ],
 [
  "E01-A4-47",
  119.2,
  121.41,
  "So the prism isn't making the"
 ],
 [
  "E01-A4-48",
  121.41,
  123.6,
  "colours, it's sorting them."
 ],
 [
  "E01-A4-49",
  123.6,
  126.47,
  "Every kind of ray was in the white sunlight all"
 ],
 [
  "E01-A4-50",
  126.47,
  128.85,
  "along, mixed together. The"
 ],
 [
  "E01-A4-51",
  128.85,
  131.63,
  "glass just spreads them out."
 ],
 [
  "E01-A4-52",
  131.63,
  134.13,
  "He checks it the other way too."
 ],
 [
  "E01-A4-53",
  134.13,
  136.53,
  "He gathers the spread -out rays back together"
 ],
 [
  "E01-A4-54",
  136.53,
  138.65,
  "with a lens. Where they"
 ],
 [
  "E01-A4-55",
  138.65,
  140.72,
  "meet, they make white again."
 ],
 [
  "E01-A4-56",
  140.72,
  142.81,
  "In his words, light,"
 ],
 [
  "E01-A4-57",
  142.81,
  145.73,
  "entirely and perfectly white."
 ],
 [
  "E01-A4-58",
  145.73,
  148.7,
  "Ever seen a little rainbow thrown on a wall by a"
 ],
 [
  "E01-A4-59",
  148.7,
  150.81,
  "window, or a glass of water?"
 ],
 [
  "E01-A4-60",
  150.81,
  154.12,
  "Then you've seen the first half of his experiment."
 ],
 [
  "E01-A4-61",
  154.12,
  156.12,
  "In his letter, he puts it"
 ],
 [
  "E01-A4-62",
  156.12,
  158.2,
  "like this. Colours"
