 [
  "E01-A4-02",
  2.4,
  4.43,
  "So let's go back to Isaac Newton."
 ],
 [
  "E01-A4-03",
  4.43,
  6.91,
  "It's the start of 1666,"
 ],
 [
  "E01-A4-04",
  6.91,
  9.62,
  "a hundred years before Dalton is born."
 ],
 [
  "E01-A4-05",
  9.62,
  12.67,
  "At least, that's the date Newton gives when he writes it"
 ],
 [
  "E01-A4-06",
  12.67,
  14.8,
  "up, six years later."
 ],
 [
  "E01-A4-07",
  14.8,
  18.29,
  "He's 23. He has just bought"
 ],
 [
  "E01-A4-08",
  18.29,
  21.54,
  "a triangular glass prism. People already"
 ],
 [
  "E01-A4-09",
  21.54,
  24.25,
  "know a prism can throw colours on a wall."
 ],
 [
  "E01-A4-10",
  24.25,
  27.7,
  "Newton wants to know where those colours come from,"
 ],
 [
  "E01-A4-11",
  27.7,
  30.05,
  "so he darkens his room."
 ],
 [
  "E01-A4-12",
  30.05,
  33.06,
  "He makes a small hole in his window shutter,"
 ],
 [
  "E01-A4-13",
  33.06,
  36.56,
  "and he lets one thin beam of sunlight in."
 ],
 [
  "E01-A4-14",
  36.56,
  39.26,
  "He puts the prism in the beam."
 ],
 [
  "E01-A4-15",
  39.26,
  41.47,
  "The glass bends the light,"
 ],
 [
  "E01-A4-16",
  41.47,
  44.9,
  "and on the far wall, a band of colours appears."
 ],
 [
  "E01-A4-17",
  44.9,
  47.56,
  "Red at one end, violet at the other,"
 ],
 [
  "E01-A4-18",
  47.56,
  49.59,
  "and everything in between."
 ],
 [
  "E01-A4-19",
  49.59,
  51.74,
  "The first thing that surprises him"
 ],
 [
  "E01-A4-20",
  51.74,
  53.88,
  "is its shape. The"
 ],
 [
  "E01-A4-21",
  53.88,
  56.04,
  "beam came in through a small round hole,"
 ],
 [
  "E01-A4-22",
  56.04,
  58.54,
  "but the band on the wall is long,"
 ],
 [
  "E01-A4-23",
  58.54,
  60.78,
  "about five times longer than it is wide."
 ],
 [
  "E01-A4-24",
  60.78,
  63.56,
  "By the rules he'd been taught,"
 ],
 [
  "E01-A4-25",
  63.56,
  66.17,
  "he says, it should have been round."
 ],
 [
  "E01-A4-26",
  66.17,
  68.45,
  "At the time, most people who thought"
 ],
 [
  "E01-A4-27",
  68.45,
  70.66,
  "about it believed something simple."
 ],
 [
  "E01-A4-28",
  70.66,
  73.9,
  "White light is pure. The prism"
 ],
 [
  "E01-A4-29",
  73.9,
  77.05,
  "changes it, and that's what makes the colours."
 ],
 [
  "E01-A4-30",
  77.05,
  80.32,
  "Newton suspects it's the other way round."
 ],
 [
  "E01-A4-31",
  80.32,
  82.61,
  "So he sets up a test he will later"
 ],
 [
  "E01-A4-32",
  82.61,
  84.77,
  "call the experimentum cruces,"
 ],
 [
  "E01-A4-33",
  84.77,
  86.8,
  "the crucial experiment."
 ],
 [
  "E01-A4-34",
  86.8,
  89.25,
  "He lets the band of colours fall on a"
 ],
 [
  "E01-A4-35",
  89.25,
  91.32,
  "board with a small hole in it."
 ],
 [
  "E01-A4-36",
  91.32,
  93.43,
  "Only one colour gets through,"
 ],
 [
  "E01-A4-37",
  93.43,
  96.64,
  "say, just the blue. Then he sends that"
 ],
 [
  "E01-A4-38",
  96.64,
  98.73,
  "blue light through a second prism."
 ],
 [
  "E01-A4-39",
  98.73,
  100.77,
  "If the glass makes the colours,"
 ],
 [
  "E01-A4-40",
  100.77,
  104.23,
