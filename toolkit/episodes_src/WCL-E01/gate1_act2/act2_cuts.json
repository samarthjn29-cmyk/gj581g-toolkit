 [
  "E01-A2-02",
  2.4,
  4.84,
  "John Dalton was born in 1766"
 ],
 [
  "E01-A2-03",
  4.84,
  6.92,
  "in Eaglesfield, a village in"
 ],
 [
  "E01-A2-04",
  6.92,
  9.24,
  "Cumberland in the northwest of England."
 ],
 [
  "E01-A2-05",
  9.24,
  11.65,
  "His family were Quakers."
 ],
 [
  "E01-A2-06",
  11.65,
  14.17,
  "Quakers keep things plain."
 ],
 [
  "E01-A2-07",
  14.17,
  16.97,
  "Plain clothes, plain words."
 ],
 [
  "E01-A2-08",
  16.97,
  19.31,
  "Dalton lives that way, and he writes"
 ],
 [
  "E01-A2-09",
  19.31,
  21.76,
  "everything down. For more than"
 ],
 [
  "E01-A2-10",
  21.76,
  23.98,
  "50 years, he keeps a diary of the"
 ],
 [
  "E01-A2-11",
  23.98,
  26.37,
  "weather, every single day."
 ],
 [
  "E01-A2-12",
  26.37,
  29.72,
  "He's been teaching in Kendal, a market town on the edge"
 ],
 [
  "E01-A2-13",
  29.72,
  32.3,
  "of the Lake District, since he was 15."
 ],
 [
  "E01-A2-14",
  32.3,
  35.11,
  "That's where the geranium happens."
 ],
 [
  "E01-A2-15",
  35.11,
  38.34,
  "Dalton takes it for granted that everyone will see the same"
 ],
 [
  "E01-A2-16",
  38.34,
  40.99,
  "change, so he asks around."
 ],
 [
  "E01-A2-17",
  40.99,
  43.68,
  "He was surprised, he wrote later,"
 ],
 [
  "E01-A2-18",
  43.68,
  46.92,
  "to find they all agreed. By Kendal,"
 ],
 [
  "E01-A2-19",
  46.92,
  49.51,
  "the colour was not much different from daylight."
 ],
 [
  "E01-A2-20",
  49.51,
  52.38,
  "Except, he says, for his brother,"
 ],
 [
  "E01-A2-21",
  52.38,
  55.2,
  "who saw it in the same light as myself."
 ],
 [
  "E01-A2-22",
  55.2,
  58.11,
  "There's another story about the two brothers."
 ],
 [
  "E01-A2-23",
  58.11,
  61.39,
  "It comes from a biography written 30 years after John"
 ],
 [
  "E01-A2-24",
  61.39,
  64.18,
  "died, so it may have grown in the telling."
 ],
 [
  "E01-A2-25",
  64.18,
  66.58,
  "One day in Kendal,"
 ],
 [
  "E01-A2-26",
  66.58,
  69.89,
  "John passes a shop window and sees a pair of stockings."
 ],
 [
  "E01-A2-27",
  69.89,
  72.0,
  "He buys them for his mother."
 ],
 [
  "E01-A2-28",
  72.0,
  74.28,
  "To him, they're a sensible dark"
 ],
 [
  "E01-A2-29",
  74.28,
  76.52,
  "colour. A bluish -dark"
 ],
 [
  "E01-A2-30",
  76.52,
  79.23,
  "drab, in the biographer's words."
 ],
 [
  "E01-A2-31",
  79.23,
  81.69,
  "His mother opens the present and says,"
 ],
 [
  "E01-A2-32",
  81.69,
  84.03,
  "they're as red as a cherry, John!"
 ],
 [
  "E01-A2-33",
  84.03,
  86.29,
  "John can't see it."
 ],
 [
  "E01-A2-34",
  86.29,
  89.23,
  "Neither can Jonathan. To both of"
 ],
 [
  "E01-A2-35",
  89.23,
  91.62,
  "them, the stockings are dark."
 ],
 [
  "E01-A2-36",
  91.62,
  94.06,
  "Two grown men, one pair of"
 ],
 [
  "E01-A2-37",
  94.06,
  96.39,
  "stockings, and a mother who is quite sure"
 ],
 [
  "E01-A2-38",
  96.39,
  98.63,
  "she's right. So,"
 ],
 [
  "E01-A2-39",
  98.63,
  102.0,
  "look at what stays the same. Everyone sees the same"
 ],
 [
  "E01-A2-40",
  102.0,
  104.08,
  "flower by the same candle."
 ],
 [
  "E01-A2-41",
  104.08,
  106.71,
  "Everyone sees the same stockings."
 ],
 [
  "E01-A2-42",
  106.71,
  109.45,
  "Only the person looking changes."
 ],
 [
  "E01-A2-43",
  109.45,
  112.77,
  "The odd thing isn't the flower or the candle."
 ],
 [
  "E01-A2-44",
  112.77,
  115.06,
  "It's the two brothers."
 ],
 [
  "E01-A2-45",
  115.06,
  117.42,
  "They aren't rare either."
 ],
 [
  "E01-A2-46",
  117.42,
  120.74,
  "Today, we'd call this a kind of colour blindness."
 ],
 [
  "E01-A2-47",
  120.74,
  124.02,
  "About eight in a hundred men of European descent have some"
 ],
 [
  "E01-A2-48",
  124.02,
  126.72,
  "trouble telling certain reds and greens apart."
 ],
 [
  "E01-A2-49",
  126.72,
  128.73,
  "For women of European descent,"
 ],
 [
  "E01-A2-50",
  128.73,
  131.06,
  "it's about four in a thousand."
 ],
 [
  "E01-A2-51",
  131.06,
  133.49,
  "So in a room of fifty of those men,"
 ],
 [
  "E01-A2-52",
  133.49,
  135.91,
  "about four would have some form of it."
 ],
 [
  "E01-A2-53",
  135.91,
  138.19,
  "It's less common among men in China and"
 ],
 [
  "E01-A2-54",
  138.19,
  140.6,
  "Japan, but it's still there."
 ],
 [
  "E01-A2-55",
  140.6,
  142.97,
  "Picture it from the inside."
 ],
 [
  "E01-A2-56",
  142.97,
  145.43,
  "You've looked at the world one way your whole"
 ],
 [
  "E01-A2-57",
  145.43,
  148.39,
  "life. Grass, blood,"
 ],
 [
  "E01-A2-58",
  148.39,
  150.4,
  "cherries, sky."
 ],
 [
  "E01-A2-59",
  150.4,
  153.0,
  "You use the same colour names as everyone"
 ],
 [
  "E01-A2-60",
  153.0,
  155.16,
  "else, and nobody has ever"
 ],
 [
  "E01-A2-61",
  155.16,
  157.24,
  "told you your red is different."
 ],
 [
  "E01-A2-62",
  157.24,
  160.3,
  "Nobody else can see what you see."
 ],
 [
  "E01-A2-63",
  160.3,
  162.38,
  "Then one evening,"
 ],
 [
  "E01-A2-64",
  162.38,
  164.55,
  "a flower changes colour, and almost"
 ],
 [
  "E01-A2-65",
  164.55,
  166.9,
  "nobody else sees it happen."
 ],
 [
  "E01-A2-66",
  166.9,
  169.75,
  "Dalton, though, is a scientist."
 ],
 [
  "E01-A2-67",
  169.75,
  172.95,
  "It's not enough for him to know that he's different."
 ],
 [
  "E01-A2-68",
  172.95,
  175.57,
  "He wants to know why."
 ]
]